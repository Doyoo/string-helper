<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.doyoo.stringhelper</id>
    <name>string-helper</name>
    <vendor>doyoo</vendor>
    <depends>com.intellij.modules.platform</depends>

    <actions>
        <group id="cn.aaron.stringtools.Group" text="String Helper" icon="/icons/pluginIcon.svg" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>

            <action id="cn.aaron.stringtools.Unicode" class="com.github.doyoo.stringhelper.actions.UnicodeSmartAction"
                    text="Unicode">
                <keyboard-shortcut first-keystroke="alt U" keymap="$default"/>
            </action>

            <action id="cn.aaron.stringtools.Base64" class="com.github.doyoo.stringhelper.actions.Base64SmartAction"
                    text="Base64">
                <keyboard-shortcut first-keystroke="alt B" keymap="$default"/>
            </action>

            <action id="cn.aaron.stringtools.Url" class="com.github.doyoo.stringhelper.actions.UrlSmartAction"
                    text="URL">
                <keyboard-shortcut first-keystroke="alt L" keymap="$default"/>
            </action>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="String Helper"
                    anchor="right"
                    icon="/icons/pluginIcon.svg"
                    factoryClass="com.github.doyoo.stringhelper.toolWindow.MyToolWindowFactory"/>
    </extensions>
</idea-plugin>
